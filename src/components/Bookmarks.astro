---
---

<section class="bookmark-manager" aria-labelledby="manager-title">
  <div class="intro">
    <p class="eyebrow">Your personal link library</p>
    <h2 id="manager-title">Keep the good ones close.</h2>
    <p class="description">Save a link and give it a little mona- shortcut. Everything stays right here in your browser.</p>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code>.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>
  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" class="list-header" hidden>
    <h3 class="list-title">Saved bookmarks</h3>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import {
    formatBookmark,
    generateSlug,
    loadBookmarks,
    normalizeUrl,
  } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const urlInput = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
  const listHeader = document.querySelector<HTMLDivElement>('#list-header');
  const status = document.querySelector<HTMLParagraphElement>('#bookmark-status');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-all');

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      return [];
    }
  }

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  let bookmarks = readBookmarks();

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setStatus(`Copied ${bookmark.slug}.`);
        } catch {
          setStatus('Could not copy the slug. Check your browser permissions.');
        }
      });

      item.append(link, document.createTextNode(' :: '), slug, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  function persistBookmarks() {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      return false;
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    try {
      if (!urlInput) throw new Error('The URL field is unavailable.');
      const url = normalizeUrl(urlInput.value);
      let slug = generateSlug();
      for (let attempt = 0; bookmarks.some((bookmark) => bookmark.slug === slug) && attempt < 10; attempt += 1) {
        slug = generateSlug();
      }
      if (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        throw new Error('Could not generate a unique slug. Please try again.');
      }

      bookmarks = [...bookmarks, { url, slug }];
      renderBookmarks();
      urlInput.value = '';
      setStatus(persistBookmarks()
        ? `Saved ${formatBookmark({ url, slug })}.`
        : 'Bookmark added for this visit, but browser storage is unavailable.');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Could not add this bookmark.');
    }
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;

    bookmarks = [];
    renderBookmarks();
    try {
      window.localStorage.removeItem(storageKey);
      setStatus('All bookmarks cleared.');
    } catch {
      setStatus('Bookmarks cleared for this visit, but browser storage is unavailable.');
    }
  });

  renderBookmarks();
</script>

<style>
  .bookmark-manager {
    --manager-accent: #8b5cf6;
    padding: clamp(1.25rem, 5vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--manager-accent) 22%, var(--border));
    border-radius: 1.25rem;
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--manager-accent) 12%, transparent), transparent 48%),
      color-mix(in srgb, var(--manager-accent) 3%, Canvas);
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, #20133b 9%, transparent);
  }

  .intro { max-width: 34rem; }
  .eyebrow {
    margin: 0 0 0.55rem;
    color: var(--manager-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.4rem, 4vw, 1.85rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .description { margin: 0.6rem 0 0; color: var(--muted); }
  form { margin-top: 1.5rem; }
  input { min-height: 3rem; }
  input:focus-visible { border-color: var(--manager-accent); }
  button[type='submit'] { min-height: 3rem; background: var(--manager-accent); }
  .hint { margin-bottom: 1rem; }
  .hint code {
    padding: 0.1rem 0.3rem;
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--manager-accent) 12%, transparent);
  }
  .status { min-height: 1.25rem; margin: 0 0 0.75rem; color: var(--muted); font-size: 0.8rem; }
  .list-header { margin-top: 1rem; }
  .bookmark { background: color-mix(in srgb, Canvas 82%, transparent); }
  .bookmark .url { color: inherit; text-decoration-color: color-mix(in srgb, var(--manager-accent) 55%, transparent); }
  .bookmark .slug { font-family: var(--font-body); font-weight: 600; }
  .bookmark .copy { margin-left: auto; }
  .empty { border-color: color-mix(in srgb, var(--manager-accent) 28%, var(--border)); }

  @media (max-width: 30rem) {
    .bookmark-manager { padding: 1.1rem; }
    form button[type='submit'] { width: 100%; }
    .bookmark .copy { margin-left: 0; }
  }
</style>
