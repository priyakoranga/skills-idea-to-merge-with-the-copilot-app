---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // TODO (Step 3): implement the bookmarks feature here.
  //   1. On form submit, call event.preventDefault() FIRST so the page
  //      never reloads, then read and validate the original URL.
  //   2. Generate a short slug with a "mona-" prefix (for example, base62
  //      of a counter or hash → "mona-7fk2").
  //   3. Save the original URL and its slug, then persist them in the browser.
  //   4. Render each saved bookmark into #bookmark-list as a row (li.bookmark) with:
  //        - the original URL as a link (.url) that opens in a new tab,
  //        - its short slug shown as a badge (.slug), and
  //        - a "Copy" button (.copy) that copies the slug.
  //   5. Toggle empty vs. saved state: hide #empty-state and show #list-header
  //      (the "Saved bookmarks" heading + "Clear all" button) once at least one
  //      bookmark exists; reverse it when the list is empty.
  //   6. Wire the #clear-all button to remove every saved bookmark (clear the
  //      list, clear browser storage) after a quick confirm.
  //   7. On page load, read the saved bookmarks from storage and render
  //      them so the list persists across reloads.
  //
  // Because this code lives in a client <script>, browser storage APIs are
  // safe to use here without breaking the static build.
  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const bookmarkList = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  function generateSlug() {
    const alphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let value = Math.random().toString(36).slice(2, 10);
    if (!value) {
      value = 'mona';
    }
    return `mona-${value}`;
  }

  function readBookmarks() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
  }

  function renderBookmarks() {
    const bookmarks = readBookmarks();

    if (!bookmarkList || !emptyState || !listHeader || !clearAllButton) {
      return;
    }

    bookmarkList.innerHTML = '';

    if (bookmarks.length === 0) {
      emptyState.hidden = false;
      listHeader.hidden = true;
      return;
    }

    emptyState.hidden = true;
    listHeader.hidden = false;

    bookmarks.forEach((bookmark) => {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const urlLink = document.createElement('a');
      urlLink.className = 'url';
      urlLink.href = bookmark.url;
      urlLink.target = '_blank';
      urlLink.rel = 'noopener noreferrer';
      urlLink.textContent = bookmark.url;

      const slugBadge = document.createElement('span');
      slugBadge.className = 'slug';
      slugBadge.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copyButton.textContent = 'Copied';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1200);
        } catch {
          copyButton.textContent = 'Copy failed';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1200);
        }
      });

      item.append(urlLink, slugBadge, copyButton);
      bookmarkList.appendChild(item);
    });
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const rawUrl = input instanceof HTMLInputElement ? input.value.trim() : '';
    if (!rawUrl) {
      return;
    }

    let value;
    try {
      value = new URL(rawUrl);
      if (!value.protocol.startsWith('http')) {
        throw new Error('Only http/https URLs are supported');
      }
    } catch {
      if (input instanceof HTMLInputElement) {
        input.setCustomValidity('Please enter a valid http or https URL.');
        input.reportValidity();
      }
      return;
    }

    if (input instanceof HTMLInputElement) {
      input.setCustomValidity('');
    }

    const bookmarks = readBookmarks();
    const slug = generateSlug();
    bookmarks.push({ url: value.toString(), slug });
    saveBookmarks(bookmarks);
    renderBookmarks();

    if (input instanceof HTMLInputElement) {
      input.value = '';
      input.focus();
    }
  });

  clearAllButton?.addEventListener('click', () => {
    const confirmed = window.confirm('Clear all saved bookmarks?');
    if (!confirmed) {
      return;
    }

    localStorage.removeItem(STORAGE_KEY);
    renderBookmarks();
  });

  renderBookmarks();
</script>
